{
  "model": "opus",
  "permisions": {
    "allow": []
  },
  "feedbackDrafts": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/runtime.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/missing.sh"
          }
        ]
      }
    ],
    "PostToolYuse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo ok"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git *)",
      "Bash(echo \\(hi\\))",
      "Bash",
      "Read(~/notes/*)",
      "Bash(rm -rf /tmp/build)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ],
    "defaultMode": "plan"
  },
  "env": {
    "ANTHROPIC_API_KEY": "sk-ant-api03-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "SAFE_REFERENCE": "${REAL_KEY}",
    "PATH_EXTRA": "/usr/local/bin",
    "SOME_TOKEN": "9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f00"
  },
  "apiKeyHelper": 99,
  "enabledPlugins": {
    "demo@somewhere": true,
    "offered@somewhere": false
  }
}
